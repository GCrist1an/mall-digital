# Copia este archivo a terraform.tfvars (está en .gitignore) y completa los valores.
tenancy_ocid     = "ocid1.tenancy.oc1..REEMPLAZAR"
user_ocid        = "ocid1.user.oc1..REEMPLAZAR"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "C:/Users/TU_USUARIO/.oci/oci_api_key.pem"
region           = "us-ashburn-1" # tu región HOME
compartment_ocid = "ocid1.compartment.oc1..REEMPLAZAR"

# La contraseña NO va aquí: pásala por variable de entorno
#   PowerShell:  $env:TF_VAR_db_password = "TuClaveSegura123"
#   bash:        export TF_VAR_db_password="TuClaveSegura123"
