# Finales de línea: LF en el repositorio para todos (Windows, macOS, Linux)
* text=auto eol=lf

# Scripts de Windows necesitan CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
